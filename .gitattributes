*.c	text eol=lf diff=cpp
*.h	text eol=lf diff=cpp
wscript text eol=lf diff=python

# --- Resonance3D ---
# Upstream normalises .c/.h/wscript to LF. Our own text files were being
# written by whichever tool touched them last, so a one-line edit could
# surface as a whole-file diff and hide the real change. Normalise the rest.
*.md        text eol=lf
*.sh        text eol=lf
*.py        text eol=lf
*.patch     text eol=lf
*.txt       text eol=lf
*.cpp       text eol=lf diff=cpp
*.hpp       text eol=lf diff=cpp
CMakeLists.txt text eol=lf
