+// absent - resonance3d's divergences.md #7c/#13). The rest of this file
+// (windows.h itself, every #undef below) still applies unchanged.
+#ifndef NXDK
 #include <winsock2.h>
+#endif
 #include <windows.h>
+#ifndef NXDK
 #include <dbghelp.h>
+#endif
 #undef PostMessage
 #undef GetCurrentTime
 #undef CreateEvent
